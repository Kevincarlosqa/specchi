# ─────────────────────────────────────────────────────────────────────────────
# SPECCHi — variables de entorno
# Copia este archivo a `.env` (local) o cárgalas en Vercel → Settings → Environment Variables.
# Sin DATABASE_URL la app arranca en MODO DEMO (PGlite en memoria con datos de ejemplo).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Supabase · PostgreSQL) ────────────────────────────────────
# Connection pooler (Supavisor, modo transaction, puerto 6543) — la usa la app en runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (puerto 5432) — la usan las migraciones (`prisma migrate`).
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# "true" fuerza el modo demo aunque haya DATABASE_URL (útil para previews).
DEMO_MODE="false"

# ── Sesiones del panel ───────────────────────────────────────────────────────
# Secreto para firmar el JWT de la cookie. Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Usuario OWNER inicial que crea `npm run db:seed` (contraseña ≥ 10 caracteres).
SEED_ADMIN_EMAIL="direccion@specchi.com.pe"
SEED_ADMIN_PASSWORD=""

# ── Claude (asistente de WhatsApp) ───────────────────────────────────────────
# Sin clave, el bot usa un flujo guiado por botones (sin IA).
ANTHROPIC_API_KEY=""
# Modelo y esfuerzo de razonamiento (low | medium | high | xhigh | max).
AI_MODEL="claude-opus-5-5"
AI_EFFORT="medium"

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Token permanente de un System User con permiso whatsapp_business_messaging.
WHATSAPP_TOKEN=""
# ID del número (no el número en sí): WhatsApp → API Setup → Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=""
# Texto libre que inventas tú; el mismo se pega en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=""
# App Secret (App settings → Basic). Valida la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_VERSION="v23.0"
# Plantilla aprobada para recordatorios fuera de la ventana de 24 h (ver README).
WHATSAPP_TEMPLATE_REMINDER="recordatorio_cita"
WHATSAPP_TEMPLATE_LANG="es"
# Plantilla aprobada por Meta para campañas; recibe el texto como único parámetro.
WHATSAPP_TEMPLATE_CAMPAIGN="campana_specchi"
# Número público (solo dígitos, con código de país) al que apuntan los botones de la web.
WHATSAPP_PUBLIC_NUMBER="51922835994"

# ── Cron de recordatorios (Vercel Cron) ──────────────────────────────────────
# Vercel lo envía como `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""

# ── Correo (Mailgun) ─────────────────────────────────────────────────────────
# Aviso por correo al equipo con cada reserva nueva. Sin clave no se envía nada.
# Mailgun → Send → Sending → Domain settings → Sending API keys.
MAILGUN_API_KEY=""
# Dominio verificado en Mailgun (ej. mg.specchi.com.pe) o el sandbox de pruebas.
MAILGUN_DOMAIN=""
# "us" o "eu", según la región donde creaste el dominio.
MAILGUN_REGION="us"
# Remitente; por defecto "SPECCHi <reservas@MAILGUN_DOMAIN>".
MAIL_FROM=""
# Destinatarios del aviso, separados por coma.
BOOKING_NOTIFY_EMAILS=""

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
